# Copy to .env and replace the placeholders with strong independent passwords.
# Never commit .env. Both ports bind to 127.0.0.1 only.
POLYBTC_DB_NAME=polybtc
POLYBTC_DB_USER=polybtc
POLYBTC_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POLYBTC_DB_HOST=127.0.0.1
POLYBTC_DB_PORT=55432
POLYBTC_REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
POLYBTC_REDIS_HOST=127.0.0.1
POLYBTC_REDIS_PORT=16379
